# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Public URL of your Supabase project (used by the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous key for public/client-side operations
# Found in Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key for server-side operations (MUST NOT be exposed to client)
# Found in Project Settings > API > Project API keys > service_role (secret)
# WARNING: Never prefix with NEXT_PUBLIC_ - this is server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
